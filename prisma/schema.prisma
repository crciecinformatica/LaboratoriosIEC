generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Perfil {
  APOIO_ACADEMICO
  OPERADOR_TI
  ADMINISTRADOR
}

enum StatusReserva {
  CRIADA
  AGUARDANDO_CONFIRMACAO
  CONFIRMADA
  CONFLITO_DE_DATAS
  REJEITADA
}

enum TipoEvento {
  CRIACAO
  ENVIO_CSC
  NOTIFICACAO_TEAMS
  ENVIO_EMAIL
  CONFIRMACAO
  REJEICAO
  CONFLITO_DETECTADO
  REAGENDAMENTO
  GOOGLE_CALENDAR_CRIADO
  GOOGLE_CALENDAR_ATUALIZADO
}

enum ModalidadeReserva {
  PRESENCIAL
  REMOTO
  RAS
}

enum StatusSolicitacaoAcesso {
  PENDENTE
  APROVADA
  REJEITADA
}

// ─── Usuários e Autenticação ──────────────────────────────────────────────────

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  codigoPessoa String?
  perfil       Perfil   @default(APOIO_ACADEMICO)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes                     Sessao[]
  solicitacoesCriadas         SolicitacaoReserva[]  @relation("CriadaPor")
  tramitacoes                 HistoricoTramitacao[]
  logsOperacao                LogOperacao[]
  solicitacoesAcessoRevisadas SolicitacaoAcesso[]   @relation("SolicitacaoAcessoRevisadaPor")

  @@map("usuarios")
}

model SolicitacaoAcesso {
  id             String                  @id @default(cuid())
  nome           String
  email          String
  codigoPessoa   String
  senhaHash      String
  status         StatusSolicitacaoAcesso @default(PENDENTE)
  motivoRejeicao String?
  revisadoPorId  String?
  revisadoPor    Usuario?                @relation("SolicitacaoAcessoRevisadaPor", fields: [revisadoPorId], references: [id])
  revisadoEm     DateTime?
  criadoEm       DateTime                @default(now())

  @@index([status])
  @@index([email])
  @@map("solicitacoes_acesso")
}

model Sessao {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  usuarioId    String
  expires      DateTime
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

// ─── Entidades Acadêmicas ─────────────────────────────────────────────────────

model Professor {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  matricula    String?  @unique
  telefone     String?
  departamento String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  turmas   Turma[]
  reservas SolicitacaoReserva[]

  @@map("professores")
}

model Turma {
  id               String   @id @default(cuid())
  codigo           String   @unique
  nome             String
  semestre         String
  curso            String
  numOferta        String?
  codigoDisciplina String
  professorId      String
  criadoEm         DateTime @default(now())

  professor Professor            @relation(fields: [professorId], references: [id])
  reservas  SolicitacaoReserva[]

  @@map("turmas")
}

model Laboratorio {
  id               String   @id @default(cuid())
  nome             String
  codigo           String   @unique
  capacidade       Int
  recursos         String[]
  softwares        String[] @default([])
  localizacao      String?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  googleCalendarId String?

  reservas SolicitacaoReserva[]

  @@map("laboratorios")
}

// ─── Reservas ─────────────────────────────────────────────────────────────────

model SolicitacaoReserva {
  id                         String        @id @default(cuid())
  titulo                     String
  status                     StatusReserva @default(CRIADA)
  motivoRejeicao             String?
  cscProtocolo               String?
  cscProtocoloPracaLiberdade String?

  modalidadeReserva   ModalidadeReserva
  softwaresUtilizados String
  numeroAlunos        Int

  solicitanteId           String?
  nomeSolicitanteExterno  String?
  emailSolicitanteExterno String?
  professorId             String
  turmaId                 String
  laboratorioId           String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitante Usuario?     @relation("CriadaPor", fields: [solicitanteId], references: [id])
  professor   Professor    @relation(fields: [professorId], references: [id])
  turma       Turma        @relation(fields: [turmaId], references: [id])
  laboratorio Laboratorio? @relation(fields: [laboratorioId], references: [id])

  // Múltiplas datas por reserva
  datas     DataHorarioReserva[]
  historico HistoricoTramitacao[]
  anexos    Anexo[]

  @@map("solicitacoes_reserva")
}

model DataHorarioReserva {
  id            String   @id @default(cuid())
  reservaId     String
  dia           DateTime // Apenas a data (hora zerada em UTC)
  horaInicio    String // "HH:MM"
  horaFim       String // "HH:MM"
  recorrente    Boolean  @default(false)
  emConflito    Boolean  @default(false)
  googleEventId String?

  reserva SolicitacaoReserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@map("datas_horario_reserva")
}

// ─── Auditoria ────────────────────────────────────────────────────────────────

model HistoricoTramitacao {
  id           String         @id @default(cuid())
  reservaId    String
  usuarioId    String?
  evento       TipoEvento
  statusAntes  StatusReserva?
  statusDepois StatusReserva?
  observacao   String?
  metadados    Json?
  criadoEm     DateTime       @default(now())

  reserva SolicitacaoReserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario?           @relation(fields: [usuarioId], references: [id])

  @@map("historico_tramitacao")
}

model Anexo {
  id          String   @id @default(cuid())
  reservaId   String
  nomeArquivo String
  url         String
  tamanho     Int
  mimeType    String
  criadoEm    DateTime @default(now())

  reserva SolicitacaoReserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@map("anexos")
}

model LogOperacao {
  id         String      @id @default(cuid())
  usuarioId  String
  acao       AcaoLog
  entidade   EntidadeLog
  entidadeId String
  descricao  String // texto legível: "Confirmou reserva 'Aula de Redes' (Lab 505)"
  metadados  Json? // valores antes/depois, campos alterados, etc.
  ip         String?
  criadoEm   DateTime    @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([entidade])
  @@index([entidadeId])
  @@index([criadoEm(sort: Desc)])
  @@index([acao])
  @@map("logs_operacao")
}

model LogIntegracao {
  id         String   @id @default(cuid())
  servico    String
  endpoint   String
  metodo     String
  payload    Json?
  resposta   Json?
  statusHttp Int?
  erro       String?
  criadoEm   DateTime @default(now())

  @@map("logs_integracao")
}

enum AcaoLog {
  CRIAR
  EDITAR
  EXCLUIR
  CONFIRMAR
  REJEITAR
  REAGENDAR
  MARCAR_CONFLITO
  UPLOAD_ANEXO
  LOGIN
  LOGOUT
}

enum EntidadeLog {
  RESERVA
  LABORATORIO
  PROFESSOR
  TURMA
  USUARIO
  FILA_CHAMADO
}

model FilaChamado {
  id           String   @id @default(cuid())
  nome         String
  flexfield    String   @unique
  disparaTeams Boolean  @default(false)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  @@map("filas_chamados")
}
