# Banco de dados (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Supabase Storage (anexos)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# CSC API
CSC_API_URL="https://csc.pucminas.br/API/api/chamado/AbrirChamado"
CSC_DETALHES_URL="https://csc.pucminas.br/API/api/chamado/RetornaDetalhesChamados"
CSC_TOKEN="[TOKEN_CSC]"
CSC_CATALOGO_ID="4293"
CSC_FLEX_FIELD_103="2307"

# CSC API - Configuração SSL/TLS (opcional)
# Opção 1: Desabilitar verificação (APENAS DESENVOLVIMENTO): 
# CSC_REJECT_UNAUTHORIZED="false"
#
# Opção 2: Caminho para certificado CA customizado:
# CSC_CA_CERT_PATH="/caminho/para/ca-cert.pem"
#
# Opção 3: Use NODE_EXTRA_CA_CERTS na linha de comando ou variável de ambiente do SO

# Microsoft Teams (Workflow Webhook)
TEAMS_WEBHOOK_URL="[URL_GERADA_NO_TEAMS_WORKFLOWS]"

# Google Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

GOOGLE_REFRESH_TOKEN=""

GOOGLE_CALENDAR_ID=""