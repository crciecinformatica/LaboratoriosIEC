# Banco de dados (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# Supabase Storage (anexos)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# CSC API
CSC_API_URL="https://csc.pucminas.br/API/api/chamado/AbrirChamado"
CSC_DETALHES_URL="https://csc.pucminas.br/API/api/chamado/RetornaDetalhesChamados"
CSC_TOKEN="[TOKEN_CSC]"
CSC_CATALOGO_ID="4293"
CSC_FLEX_FIELD_103="2307"
CSC_FLEX_FIELD_103_PRACA_LIBERDADE="1381"
CSC_CODIGO_PESSOA_FALLBACK="919880"

# CSC API — Produção (variáveis com sufixo _PRODUCAO)
# Estas sobrescrevem as variáveis base quando APP_ENV=producao
CSC_API_URL_PRODUCAO="https://csc.pucminas.br/API/api/chamado/AbrirChamado"
CSC_DETALHES_URL_PRODUCAO="https://csc.pucminas.br/API/api/chamado/RetornaDetalhesChamados"
CSC_TOKEN_PRODUCAO="[TOKEN_CSC_PRODUCAO]"
CSC_CATALOGO_ID_PRODUCAO="4293"
CSC_FLEX_FIELD_103_PRODUCAO="2307"
CSC_FLEX_FIELD_103_PRACA_LIBERDADE_PRODUCAO="1381"

# CSC API — Homologação (variáveis com sufixo _HOMOLOGACAO)
# Estas são usadas quando APP_ENV=homologacao (padrão)
CSC_API_URL_HOMOLOGACAO="https://csc-homolog.pucminas.br/API/api/chamado/AbrirChamado"
CSC_DETALHES_URL_HOMOLOGACAO="https://csc-homolog.pucminas.br/API/api/chamado/RetornaDetalhesChamados"
CSC_TOKEN_HOMOLOGACAO="[TOKEN_CSC_HOMOLOGACAO]"
CSC_CATALOGO_ID_HOMOLOGACAO="4293"
CSC_FLEX_FIELD_103_HOMOLOGACAO="2307"
CSC_FLEX_FIELD_103_PRACA_LIBERDADE_HOMOLOGACAO="1381"

# Ambiente da aplicação (producao | homologacao)
# Importante: NODE_ENV costuma ser "production" tanto em homologação quanto em produção.
# Use APP_ENV para distinguir — defina explicitamente em cada deploy.
APP_ENV="homologacao"

# Microsoft Teams (Workflow Webhook)
TEAMS_WEBHOOK_URL="[URL_GERADA_NO_TEAMS_WORKFLOWS]"

